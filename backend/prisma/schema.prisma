generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  createdAt         DateTime           @default(now())
  journals          Journal[]
  weeklyReflections WeeklyReflection[]
}

model Journal {
  id        String            @id @default(uuid())
  title     String
  content   String
  createdAt DateTime          @default(now())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses  JournalAnalysis[]

  @@index([userId])
}

model JournalAnalysis {
  id               String   @id @default(uuid())
  summary          String
  mood             String
  emotionalScore   Int
  reflectionPrompt String
  detectedPatterns String
  aiModel          String
  analyzedAt       DateTime @default(now())
  journalId        String
  journal          Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId])
  @@index([analyzedAt])
  @@index([journalId, analyzedAt])
}

model WeeklyReflection {
  id              String   @id @default(uuid())
  overallTrend    String
  recurringThemes String
  deepInsight     String
  actionStep      String
  weekStart       DateTime
  createdAt       DateTime @default(now())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}
