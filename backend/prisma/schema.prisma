generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  journals          Journal[]
  weeklyReflections WeeklyReflection[]
}

model Journal {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  analyses JournalAnalysis[]

  @@index([userId])
}

model JournalAnalysis {
  id               String   @id @default(uuid())
  summary          String
  mood             String
  emotionalScore   Int
  reflectionPrompt String
  detectedPatterns String
  aiModel          String
  analyzedAt       DateTime @default(now())

  journal   Journal @relation(fields: [journalId], references: [id])
  journalId String

  @@index([journalId])
  @@index([analyzedAt])
  @@index([journalId, analyzedAt])
}

model WeeklyReflection {
  id              String @id @default(uuid())
  overallTrend    String
  recurringThemes String
  deepInsight     String
  actionStep      String

  weekStart DateTime
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@unique([userId, weekStart])
}
